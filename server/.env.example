# ── Server ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Allowed frontend origin (no trailing slash)
CORS_ORIGIN=https://yourdomain.com

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/pushdoc?retryWrites=true&w=majority

# ── Redis ────────────────────────────────────────────────────
# Full Redis connection URL (takes precedence over REDIS_HOST/REDIS_PORT)
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── GitHub OAuth App ─────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://yourdomain.com/auth/github/callback

# ── GitHub App (for installation & webhooks) ─────────────────
GITHUB_APP_ID=
GITHUB_APP_NAME=
GITHUB_WEBHOOK_SECRET=
# In production, mount from a Render Secret File, Railway mounted volume, or Docker secret.
# Never commit the .pem file to git.
GITHUB_PRIVATE_KEY_PATH=

# ── JWT ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── AI Keys (at least one Gemini or Groq key required) ───────
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

GROQ_API_KEY_1=
GROQ_API_KEY_2=

# Model configuration. Keep these outside source code so provider changes do not require a deploy.
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
AI_MAX_OUTPUT_TOKENS=8192
# legacy | shadow | antigravity. Antigravity requires the service URL and shared token.
AI_BACKEND=legacy
AI_SERVICE_URL=http://pushdoc-ai:8000
AI_SERVICE_TOKEN=
# Must be identical to AI_SERVICE_TOKEN; used inside the Python sidecar.
PUSHDOC_AI_SERVICE_TOKEN=

# ── PushDoc AI sidecar ──────────────────────────────────────
# Keep false until provider credentials and a staging preflight are confirmed.
PUSHDOC_ENABLE_LLM_DRAFTING=false
PUSHDOC_DRAFTER_BASE_URL=
PUSHDOC_DRAFTER_API_KEY=
# Reuses the existing numbered Gemini key. The sidecar also needs the base URL.
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Optional hosted TEI endpoints; without these, retrieval is explicitly BM25-only.
PUSHDOC_EMBEDDING_BASE_URL=
PUSHDOC_EMBEDDING_API_KEY=
PUSHDOC_RERANK_BASE_URL=
PUSHDOC_RERANK_API_KEY=

# ── Workspace (where cloned repos are temporarily stored) ────
# Use an absolute path on the server — e.g. /var/pushdoc/workspaces
# Leave blank to use the default: ./temp/workspaces
WORKSPACE_ROOT_PATH=
